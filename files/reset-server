#!/usr/bin/env python3
"""The web terminal's /reset page: GET shows a button, POST runs claude-reset and sends the browser back to the
terminal. Same login as ttyd (user claude, WEB_PASSWORD); POSTs from other sites are refused (basic auth alone would
let any page you visit submit the form)."""
import base64
import hmac
import html
import os
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

AUTH = "Basic " + base64.b64encode(f"claude:{os.environ.pop('WEB_PASSWORD')}".encode()).decode()
PAGE = """<!doctype html><meta name="viewport" content="width=device-width"><title>Reset Claude</title>
<body style="font-family:system-ui,sans-serif;max-width:34em;margin:3em auto;padding:0 1em">
<h1>Reset Claude</h1><p>{msg}</p>
<form method="post"><p><label><input type="checkbox" name="workspace" value="1"> Also delete everything in /workspaces</label>
<p><button style="font-size:1.1em;padding:.4em 1.2em">Reset session</button> &nbsp; <a href="/">Back to the terminal</a></form>"""


class Handler(BaseHTTPRequestHandler):
    def authorized(self):
        if hmac.compare_digest(self.headers.get("Authorization", "").encode(), AUTH.encode()):
            return True
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="claude-pod"')
        self.end_headers()
        return False

    def page(self, code, msg):
        body = PAGE.format(msg=msg).encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.authorized():
            self.page(200, "Ends the running Claude session and forgets its conversations. "
                           "The next time the terminal loads, a fresh session starts.")

    def do_POST(self):
        if not self.authorized():
            return
        if self.headers.get("Origin", "").split("://")[-1] != self.headers.get("Host"):
            return self.page(403, "Refused: the request came from another site.")
        form = self.rfile.read(int(self.headers.get("Content-Length") or 0)).decode()
        r = subprocess.run(["claude-reset", *(["--workspace"] if "workspace=1" in form else [])],
                           capture_output=True, text=True, check=False, timeout=60)
        if r.returncode:
            return self.page(500, "Reset failed: " + html.escape(r.stderr[-500:]))
        self.send_response(303)
        self.send_header("Location", "/")
        self.end_headers()


ThreadingHTTPServer(("", 7682), Handler).serve_forever()
